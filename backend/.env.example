# Bu dosyayı ".env" adıyla kopyalayın:  cp .env.example .env
#
# NOT: Bir API anahtarınız yoksa bu dosyayı hiç düzenlemenize gerek yok — uygulamayı
# ./start.sh ile açtığınızda tarayıcı sizden Claude API anahtarınızı isteyecek ve
# bu dosyayı sizin için otomatik olarak dolduracaktır.

# Ajanların Claude'a nasıl bağlanacağı:
#   subscription -> Bu bilgisayarda giriş yapılmış Claude Code (`claude`) üzerinden, Claude Pro/Max aboneliğinizle.
#                   API kredisi gerekmez; kullanım aboneliğinizin limitlerinden düşer. (varsayılan)
#   api          -> ANTHROPIC_API_KEY ile, kullandıkça ödenen API kredisiyle. Tarayıcıdaki anahtar
#                   istemi de bu modu seçer.
LLM_BACKEND=subscription

# --- subscription modu ---
# Boş bırakılırsa aboneliğinizin varsayılan modeli kullanılır. Örnek: opus, sonnet
CLAUDE_CLI_MODEL=
# Tek bir ajan cevabı için en uzun bekleme süresi (saniye)
CLI_TIMEOUT_S=900

# --- api modu ---
# Anahtar: https://platform.claude.com/settings/keys  (kredi yüklü olmalı)
# Boş bırakabilirsiniz: tarayıcıdaki anahtar istemine girdiğiniz değer buraya otomatik yazılır.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Ajan başına düşünme derinliği: low | medium | high | xhigh | max
EFFORT_PLANNER=medium
EFFORT_CODER=high
EFFORT_INSPECTOR=medium

# Görsel denetçinin isteyebileceği en fazla otonom revizyon turu
MAX_VISUAL_REVISIONS=3
# Her turda kod hatası için en fazla düzeltme denemesi
MAX_FIX_ATTEMPTS=4
# Üretilen CAD kodunun çalışma süresi sınırı (saniye)
EXEC_TIMEOUT_S=120
